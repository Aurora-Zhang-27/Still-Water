# Copy this file to .env and fill in your own values. .env is in .gitignore and never committed.
# A value left as your_..._here counts as empty.

# IBKR Flex Web Service (Account Management → Reports → Flex Queries)
IBKR_FLEX_TOKEN=your_flex_token_here
IBKR_FLEX_QUERY_ID_ACTIVITY=your_activity_query_id_here
IBKR_FLEX_QUERY_ID_TRADE_CONFIRM=your_trade_confirmation_query_id_here
# Optional: statements for any other account are rejected
IBKR_ACCOUNT_ID=your_account_id_here

# Read-only IB Gateway (not used yet)
IB_GATEWAY_HOST=127.0.0.1
IB_GATEWAY_PORT=4002
IB_CLIENT_ID=7

# Local paths (relative to the project root)
DB_PATH=data/trading.db
RULES_PATH=rules.yaml
